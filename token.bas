INPUT "Time limit for the link to be valid (in seconds) : ", t
'####################################################################
'---------------------------DATA STRUCTURE--------------------------
'* Only a "single" string will be passed to server containing all data and authentication
'* First 10 chars/bytes -> random chars
'* Next 10 chars/bytes -> expire time (CODED)
'* Next 2 chars/bytes -> number of players in the board data (CODED)
'* Next 1 char/byte -> game mode (CODED)
'* Next contain board data of players (CODED)
'* Next 16 chars/bytes -> authentication


DIM serverData AS STRING
serverData = generateGarbage(10) 'garbage data to confuse hackers. lol
serverData = serverData + numToCode(getCurrentUnixTime~&+t,10) 'this will our expire time.
serverData = serverData + numToCode(2,2) 'number of players data, in this example, it is 2
